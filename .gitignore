# Build artifacts
build/
dist/

# Environment costants and secure keys
.env

# Virtual environments
venv/
.venv/
.venv_wsl/

# JetBrain Rider folder
.idea/
.run/
.junie/

# Visual Studio cache directory
.vs/
.vsconfig 

# Python packaging
*.egg-info/
.eggs/

# Bytecode
__pycache__/
*.pyc

# Backend output folder
output/

# Database
backend/data/*.db-shm
backend/data/*.db-wal

# Test environment (scripts/testenv.py) — throwaway, regenerated by `testenv.py seed`
.testenv/
.mxworktrees/
testenv.local.toml
test_environment/e2e/node_modules/
test_environment/e2e/test-results/
test_environment/e2e/playwright-report/

# Issue tracking (scripts/issues.py) — local per-tracker fast-path caches only, the API is
# always the source of truth; safe to delete any time.
.mxissues/

# Execution strategies (scripts/testenv.py run / scripts/mxfix/) — check-suite output
# and fixer raw logs. Matches both the top-level .mxfix/ scratch dir AND the per-attempt
# .mxfix-check/ / .mxfix-codex*.json* / .mxfix-claude.json files git_target.py's
# `git add -A` would otherwise stage straight into a fix commit inside a worktree.
.mxfix*

# Item registry lock and staged writes (backend/.../file_system/item_registry.py); transient.
content/**/.items_registry.*
content/**/.items_*.csv.tmp
content/**/.*.deleting/
