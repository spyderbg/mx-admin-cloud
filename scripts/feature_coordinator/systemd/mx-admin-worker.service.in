# mx-admin-cloud — autonomous feature Worker (W4): a systemd USER service TEMPLATE.
#
# Rendered by `feature.py [--state-dir DIR] [--project-config FILE] [--tracker github] worker
# systemd-unit [--config FILE]` (paths filled in; the explicit global options are kept in ExecStart,
# before `worker start`). It is NEVER
# installed, enabled or started automatically: an operator does that (worker-autonomy.md §10).
# No credentials here: Claude Code and Codex keep using their own subscription logins under the
# user's HOME, which the user manager provides (with XDG_*) to the service.
# A user service runs only while the machine is on and awake; it cannot run through suspend or
# power-off. Without `loginctl enable-linger` it also stops when the user logs out.

[Unit]
Description=mx-admin-cloud autonomous feature Worker (W4)
Documentation=file://@REPO@/docs_agents/coordination/worker-autonomy.md
# Restart-loop protection (in addition to the service's own exit 78): at most 5 starts in 15 minutes.
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@PYTHON@ @REPO@/scripts/feature.py --repo @REPO@@STATE_ARG@@CONFIG_ARG@@TRACKER_ARG@ worker start
# The agent CLIs' directories (no secrets): a user manager's default PATH may not include them.
Environment=PATH=@PATH@
Environment=PYTHONUNBUFFERED=1
# Restart after an unexpected failure, with a delay. Never for 73 (another service owns the
# state directory) or 78 (refused by configuration, or the same startup failure repeated).
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=73 78
# Graceful stop: SIGTERM to the service only; it cancels its active agent (W3: completed
# checkpoints stay; the interrupted step runs again later) and exits. Anything left after
# TimeoutStopSec is killed.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=180
# Logs: journalctl --user -u mx-admin-worker
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
