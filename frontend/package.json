{
  "name": "frontend",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "test:voices": "node --experimental-strip-types --test tests/itemVoices.test.ts tests/itemVoicesApi.test.mjs",
    "test:content": "node --test tests/contentAvailability.test.mjs",
    "test:auth": "node --test tests/auth.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@vitejs/plugin-vue": "^6.0.5",
    "msw": "^2.12.14",
    "sirv": "^3.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vue-tsc": "^3.2.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
