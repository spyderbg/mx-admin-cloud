OPENAI_API_KEY=''
QWEN_API_KEY=''
ELEVENLABS_API_KEY=''
SPEAKTOR_API_KEY=''
GEMINI_API_KEY=''
COMFYUI_API_KEY=''

# GitHub personal access token for test environment issues and pull requests
GITHUB_PATH=''

# Docker Compose only: host directory bind-mounted to /app/content in the backend/frontend
# containers (docker/docker-compose.yml). Defaults to ../content (the repo's own content/
# folder). Override here if your real content lives elsewhere on this machine.
# CONTENT_HOST_DIR=/path/to/your/content

# "Log in with Google" on the login page. Off unless GOOGLE_AUTH_ENABLED=true and GOOGLE_CLIENT_ID
# is an OAuth web client id (Google Cloud console) listing the frontend's origin, e.g.
# http://localhost:9001, as an authorized JavaScript origin. A Google account whose email is no
# user's username yet is registered automatically as a read-only viewer.
# GOOGLE_AUTH_ENABLED=false
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
