### Add a voice to an item
# language is the ISO code for the new voice; fails with 409 if the item already has a voice for it.
POST {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/voices
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="language"

de
--WebAppBoundary
Content-Disposition: form-data; name="audio"; filename="item_voice.mp3"
Content-Type: audio/mpeg

< ./fixtures/item_voice.mp3
--WebAppBoundary--

### Generate a new voice for an item
# Synthesizes text with the named text-to-speech configuration (enabled or not) as a new variant;
# the main voice is kept. speed/stability/similarity are optional overrides; optimize also runs
# the active voice optimizers on the new voice.
POST {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/voices/generate
Content-Type: application/json

{
  "language": "en",
  "text": "apple",
  "configuration_name": "elevenlabs",
  "speed": 0.9,
  "stability": 0.5,
  "similarity": 0.75,
  "optimize": true
}

### Update voice for an item
# voice_id identifies the item+language pair; fails with 404 if it has no audio file yet.
PUT {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/voices/{{item_voice_id}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="audio"; filename="item_voice.mp3"
Content-Type: audio/mpeg

< ./fixtures/item_voice.mp3
--WebAppBoundary--

### Delete a voice from an item
DELETE {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/voices/{{item_voice_id}}

### Delete a voice from an item - category not found
DELETE {{settings.CONTENT_URL}}/categories/does_not_exist/icon

### Delete a voice from an item - item not found
DELETE {{settings.CONTENT_URL}}/categories/{{category_id}}/items/does_not_exist

### Delete a voice from an item - voice not found
DELETE {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/voices/does_not_exist

### Set a voice variant as the item's main voice for its language
# voice_id is a per-language voice id or a variant id; its language is derived from voice_id itself.
# The original recording is kept as a variant too.
PUT {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/voices/{{item_voice_id}}/main

### Set a voice variant as the item's main voice for its language - already the main voice
# Idempotent: selecting the language's current main voice id is a no-op and returns 200.
PUT {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/voices/{{item_voice_id}}/main

### Set a voice variant as the item's main voice for its language - category not found
PUT {{settings.CONTENT_URL}}/categories/does_not_exist/items/{{item_id}}/voices/{{item_voice_id}}/main

### Set a voice variant as the item's main voice for its language - item not found
PUT {{settings.CONTENT_URL}}/categories/{{category_id}}/items/does_not_exist/voices/{{item_voice_id}}/main

### Set a voice variant as the item's main voice for its language - voice not found
# voice_id must be an existing variant for the item, not just any known voice id.
PUT {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/voices/does_not_exist/main

### Create optimized versions of an item voice
# Runs every active voice optimizer on the original recording; each result is stored as a new variant.
# Fails with 400 only when no optimizer is active or all of them fail (see 'warnings' in the response).
POST {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/voices/{{item_voice_id}}/optimize
