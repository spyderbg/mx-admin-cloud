### Add an image file variant to an item
# Stored at the next available index ({item_folder_name}_{NN}.<ext>); no id is supplied by the caller.
POST {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/images
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="image"; filename="item_image.png"
Content-Type: image/png

< ./fixtures/item_image.png
--WebAppBoundary--

### Replace a specific image file variant
# image_id is the on-disk filename stem; replaces the file created at item creation.
PUT {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/images/{{item_image_id}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="image"; filename="item_image.png"
Content-Type: image/png

< ./fixtures/item_image.png
--WebAppBoundary--

### Replace a specific image file variant - not found
PUT {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/images/does_not_exist
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="image"; filename="item_image.png"
Content-Type: image/png

< ./fixtures/item_image.png
--WebAppBoundary--

### Delete an image from an item
# item_file_index is the variant's position; at least one variant must remain.
DELETE {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/images/{{image_image_id}}

### Delete an image from and item - category not found
DELETE {{settings.CONTENT_URL}}/categories/does_not_exist/icon

### Delete an image from and item - item not found
DELETE {{settings.CONTENT_URL}}/categories/{{category_id}}/items/does_not_exist

### Delete an image from and item - image not found
DELETE {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/images/does_not_exist

################################################################################

### Add a voice to an item
# language is the ISO code for the new voice; fails with 409 if the item already has a voice for it.
POST {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/voices
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="language"

de
--WebAppBoundary
Content-Disposition: form-data; name="audio"; filename="item_voice.mp3"
Content-Type: audio/mpeg

< ./fixtures/item_voice.mp3
--WebAppBoundary--

### Update voice for an item
# voice_id identifies the item+language pair; fails with 404 if it has no audio file yet.
PUT {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/voices/{{item_voice_id}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="audio"; filename="item_voice.mp3"
Content-Type: audio/mpeg

< ./fixtures/item_voice.mp3
--WebAppBoundary--

### Delete a voice from an item
DELETE {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/voices/{{item_voice_id}}

### Delete a voice from an item - category not found
DELETE {{settings.CONTENT_URL}}/categories/does_not_exist/icon

### Delete a voice from an item - item not found
DELETE {{settings.CONTENT_URL}}/categories/{{category_id}}/items/does_not_exist

### Delete a voice from an item - voice not found
DELETE {{settings.CONTENT_URL}}/categories/{{category_id}}/items/{{item_id}}/voices/does_not_exist

################################################################################
