{
  "service_provider": {
    "service": "text_to_speech",
    "provider": "speaktor",
    "enabled": false,
    "priority": 2,
    "config": {
      "generate": {
        "endpoint": "https://api.tor.app/developer/text_to_speech",
        "method": "POST",
        "response_mode": "json_url",
        "audio_field": "audioUrl",
        "headers": {
          "Authorization": "Bearer {api_key}",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "payload_template": {
          "text": "{text}",
          "language": "{language}",
          "voice_name": "{voice_name}"
        },
        "languages": {
          "en": {
            "voice_name": "Sveta",
            "speed_rate": 1,
            "use_space": "no"
          },
          "fr": {
            "voice_name": "Marie",
            "speed_rate": 1,
            "use_space": "no"
          },
          "es": {
            "voice_name": "Carmen",
            "speed_rate": 1,
            "use_space": "no"
          },
          "bg": {
            "voice_name": "Света",
            "speed_rate": 1,
            "use_space": "yes"
          }
        }
      },
      "evaluate": {
        "enabled": false,
        "stt_provider": "speaktor",
        "language": "en-US",
        "poll_interval_seconds": 3,
        "poll_max_attempts": 40
      }
    }
  }
}
