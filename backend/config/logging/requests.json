{
  "service_provider": {
    "service": "logging",
    "provider": "struct_log",
    "enabled": true,
    "priority": 1,
    "version": "1.0",
    "config": {
      "request_log": {
        "path": "results/requests.log",
        "fields": {
          "provider": true,
          "translator": true,
          "model": true,
          "actor": true,
          "voice_id": true,
          "language": true,
          "input": true,
          "response_duration": true,
          "timestamp": true
        }
      }
    }
  }
}
