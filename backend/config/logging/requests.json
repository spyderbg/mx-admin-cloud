{
  "service_provider": {
    "service": "logging",
    "provider": "struct_log",
    "provider_category": "requests",
    "enabled": true,
    "priority": 1,
    "version": "1.0",
    "config": {
      "formatters": {
        "plain": {
          "format": "%(message)s"
        }
      },
      "handlers": {
        "requests_file": {
          "class": "logging.handlers.RotatingFileHandler",
          "level": "TRACE",
          "formatter": "plain",
          "filename": "${output_dir}/results/requests.log",
          "maxBytes": 10485760,
          "backupCount": 5
        }
      },
      "request_log": {
        "fields": {
          "provider": true,
          "model": true,
          "actor": true,
          "voice_id": true,
          "language": true,
          "input": true,
          "response_duration": true,
          "timestamp": true
        }
      }
    }
  }
}
